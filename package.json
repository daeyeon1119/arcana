{
  "name": "arcana-tarot",
  "version": "84.0.0",
  "private": true,
  "description": "Offline Korean tarot reflection app and reproducible reading checks",
  "scripts": {
    "build": "python scripts/build.py",
    "test:stress": "node scripts/stress.cjs",
    "test:ui": "node scripts/ui.cjs",
    "test:images": "node scripts/images.cjs",
    "test:mat": "node scripts/mat.cjs after",
    "test:portable": "node scripts/portable.cjs",
    "verify:public": "node scripts/public-check.cjs",
    "test:editorial": "node scripts/editorial.cjs v84",
    "test:question-model": "node tests/question-model.cjs",
    "test:task-policy": "node tests/task-policy.cjs",
    "test:reading-evidence": "node tests/reading-evidence.cjs",
    "test:reading-bridge": "node tests/reading-bridge.cjs",
    "test:grounding": "node scripts/grounding-reading.cjs development",
    "test:grounding-ui": "node scripts/grounding-ui.cjs",
    "report:grounding": "python scripts/grounding_report.py",
    "test:task-reading": "node scripts/task-reading.cjs development",
    "test:task-regression": "node scripts/task-reading.cjs regression && node scripts/task-reading.cjs fresh-regression",
    "test:local-contract": "node tests/local-reader-core.cjs",
    "test:local-planner": "node tests/local-reader-planner.cjs",
    "test:local-separated": "node tests/local-reader-separated.cjs",
    "test:local-transport": "node tests/local-model-http.cjs",
    "test:local-config": "node tests/local-reader-config.cjs",
    "test:local-report": "python tests/local-reader-report.py",
    "diagnose:local-native": "node scripts/local-reader-native.cjs",
    "diagnose:local-qwen35": "node scripts/local-reader-native.cjs --profile=qwen35-9b",
    "diagnose:local-staged": "node scripts/local-reader-native.cjs --staged",
    "diagnose:local-separated": "node scripts/local-reader-native.cjs --profile=qwen35-9b --separated",
    "diagnose:local-browser": "node scripts/local-reader-diagnostic.cjs",
    "report:local-reader": "python scripts/local_reader_report.py",
    "report:blind-review": "python scripts/local_blind_review.py",
    "test:blind-review": "npm run report:blind-review && node scripts/local-blind-check.cjs",
    "test:question-regression": "node scripts/question-unseen.cjs regression",
    "test:synthesis": "node scripts/synthesis.cjs v84",
    "diagnose:generalization": "node scripts/context.cjs",
    "report:synthesis": "python scripts/synthesis_report.py",
    "report:questions": "python scripts/question_report.py",
    "test": "npm run test:local-contract && npm run test:local-planner && npm run test:local-separated && npm run test:local-transport && npm run test:local-config && npm run test:local-report && npm run test:blind-review && npm run test:question-model && npm run test:task-policy && npm run test:reading-evidence && npm run test:reading-bridge && npm run test:grounding && npm run test:task-reading && npm run test:stress && npm run test:ui && npm run test:grounding-ui && npm run test:images && npm run test:mat && npm run test:portable && npm run test:editorial && npm run test:synthesis && npm run diagnose:generalization && npm run test:question-regression"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
